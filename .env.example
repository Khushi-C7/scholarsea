# ---------------------------------------------------------------------------
# ScholarSea environment — copy to `.env` for local dev, or set these in your
# Vercel project settings. This template contains PLACEHOLDERS ONLY.
# Never commit a real `.env`.
# ---------------------------------------------------------------------------

# ===== Required =====

# PostgreSQL connection string (app + Prisma). On Vercel, use a managed
# Postgres (Neon, Vercel Postgres, Supabase, …) and paste its connection
# string here. Append ?sslmode=require for most hosted providers.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scholarsea?schema=public&sslmode=require"

# Secret used to sign session cookies. Generate a strong value:
#   openssl rand -base64 48
AUTH_SECRET=""

# ===== Optional =====

# Only used by `prisma migrate dev` for local drift detection. NOT needed on
# Vercel (deploys use `prisma migrate deploy`, which has no shadow DB).
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/scholarsea_shadow?schema=public"

# Secret used to derive the AES-256-GCM key that encrypts user-supplied
# provider API keys before they are stored. Generate with:
#   openssl rand -base64 32
# If unset, the app derives the key from AUTH_SECRET so Settings still works;
# set a dedicated value in production so rotating one secret doesn't affect the
# other.
CREDENTIAL_ENCRYPTION_KEY=""

# AI provider. If AI_API_KEY and AI_BASE_URL are both set, the app uses real
# analysis; otherwise it runs in clearly-labeled demo mode (no key required
# for the app to load and work).
AI_PROVIDER="openai"
AI_BASE_URL="https://api.openai.com/v1"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Public base URL of the deployed app (used for absolute links in exports).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
